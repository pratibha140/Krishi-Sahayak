# .env.example
# Krishi Sahayak - Environment Configuration Template
# ==============================================================================
# Instructions:
# Copy this file to .env and set appropriate values for your environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or real secrets to source control.
# ==============================================================================

# [MANDATORY IN PRODUCTION]
# Secret key used for cryptographic session signing and CSRF tokens.
# Must be at least 32 bytes of secure random data. If missing when FLASK_ENV=production,
# the application will immediately abort startup with a RuntimeError.
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# [ENVIRONMENT MODE]
# Set to 'production' for live deployments, or 'development' for local development.
# When set to 'production':
#   - SECRET_KEY becomes strictly required
#   - SESSION_COOKIE_SECURE is enabled (requires HTTPS)
#   - Strict-Transport-Security (HSTS) header is enabled
#   - Static file caching headers are enabled
#   - Console verification links are silenced
FLASK_ENV=production

# [NETWORK PORT]
# Port on which the application server listens (default: 5000)
PORT=5000

# [SECURITY TOGGLE - MOCK AUTH]
# Must be set to '0' in production.
# Only set to '1' during offline local development to test authentication flows
# without needing genuine Google OAuth2 credentials.
ENABLE_DEV_MOCK_AUTH=0

# [DATABASE LOCATION - OPTIONAL]
# Optional path override for the SQLite database file.
# If left blank, the application defaults to 'database.db' in the project root directory.
DATABASE_PATH=

# [EMAIL DELIVERY SERVICE - MANDATORY IN PRODUCTION FOR REGISTRATION]
# Required in production for delivering account verification emails to farmers.
# In local development, instant test verification links are displayed in the UI when unconfigured.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=

